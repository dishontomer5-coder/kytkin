<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- P2-3: Kytkin's only entitlement. Hardened-runtime apps need it to send Apple Events at all
     (the opt-in browser-URL fallback, R3/R8). Not sandboxed: no app-sandbox key on purpose. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
