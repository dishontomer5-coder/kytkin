#!/usr/bin/env bash
# P2-15: Build and run the headless watch-context tool. It prints one line per Context the tier-0
# ContextMonitor emits (bundle ID, pid, generation) while you switch apps. Ctrl-C stops it.
# Listen-only: no window, no permission, never activates or messages another app.
#   ./scripts/watch-context [--debounce-ms N]
#   KYTKIN_BUILD_ONLY=1 ./scripts/watch-context   compile only (used by agents; nothing runs)
# The tool is compiled from the app's own sources (System/Context + System/Browser adapters + all of Core).
set -euo pipefail

cd "$(dirname "$0")/.."
BIN="build/tools/watch-context"
mkdir -p "$(dirname "$BIN")"

# QA (P3-29): ContextMonitor now also drives the browser watcher (P3-5/P3-10), so like watch-site the tool compiles
# all of Core (pure) + System/Context + System/Browser (+ the silent Automation check System/Browser calls). The tool
# never attaches a browser watcher, so no AX read and no Apple Event is ever made.
SOURCES=(Tools/watch-context/main.swift Sources/System/Context/*.swift Sources/System/Browser/*.swift
         Sources/System/Permissions/SystemAutomationPermission.swift)
while IFS= read -r -d '' f; do SOURCES+=("$f"); done < <(find Sources/Core -name '*.swift' -type f -print0)

xcrun swiftc -swift-version 6 -O -target "$(uname -m)-apple-macos14.0" -module-name WatchContext -o "$BIN" "${SOURCES[@]}"
[[ "${KYTKIN_BUILD_ONLY:-}" == 1 ]] && exit 0
exec "$BIN" "$@"
